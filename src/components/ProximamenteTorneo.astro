<section class="soon wrap" aria-label="Próximamente en esta web">
  <p class="sec-head reveal">Muy pronto en esta web</p>
  <h2 class="h2 reveal">El día del torneo,<br />en directo aquí</h2>
  <div class="soon-row reveal">
    <button class="soon-btn" type="button" disabled aria-disabled="true">
      <span class="soon-ico" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 4h12v3a6 6 0 0 1-12 0V4Z"></path>
          <path d="M6 6H4a2 2 0 0 0 0 4h2"></path>
          <path d="M18 6h2a2 2 0 0 1 0 4h-2"></path>
          <path d="M12 13v4"></path>
          <path d="M9 20h6"></path>
          <path d="M10 17h4v3h-4z"></path>
        </svg>
      </span>
      <span class="soon-label">Clasificación en directo</span>
      <span class="soon-tag">Próximamente</span>
    </button>
    <button class="soon-btn" type="button" disabled aria-disabled="true">
      <span class="soon-ico" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2 2 2 0 0 0 0 4 2 2 0 0 1-2 2H5a2 2 0 0 1-2-2 2 2 0 0 0 0-4Z"></path>
          <path d="M14 6v2"></path>
          <path d="M14 11v2"></path>
          <path d="M14 16v2"></path>
        </svg>
      </span>
      <span class="soon-label">La porra</span>
      <span class="soon-tag">Próximamente</span>
    </button>
  </div>
</section>

<style>
  .soon {
    margin: 70px auto;
  }

  .sec-head {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--amber);
  }

  .h2 {
    font-family: var(--display);
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 0.92;
    text-transform: uppercase;
    margin: 14px 0 0;
  }

  .soon-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 24px;
  }

  .soon-btn {
    flex: 1 1 240px;
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px 20px;
    color: var(--cream);
    font-family: var(--sans);
    font-size: 16px;
    text-align: left;
    cursor: not-allowed;
    opacity: 0.85;
  }

  .soon-btn:disabled {
    pointer-events: none;
  }

  .soon-ico {
    display: inline-flex;
    color: var(--muted);
    flex-shrink: 0;
  }

  .soon-label {
    font-weight: 500;
    flex: 1;
  }

  .soon-tag {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--amber);
    border: 1px solid rgba(246, 167, 44, 0.4);
    border-radius: 999px;
    padding: 4px 10px;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .soon-row {
      flex-direction: column;
    }

    .soon-btn {
      flex: 1 1 auto;
    }
  }
</style>
