---

---

<section class="close" id="inscripcion">
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow"><span class="dot"></span><span id="closeEyebrow">Inscripción abierta</span></span>
      <h2 id="closeTitle">Coge tu<br />plaza</h2>
      <p id="closeCopy">Solo 48 equipos. Cuando se llenan, se llenan. Rellena los datos y guardamos tu sitio.</p>
      <p class="close-reason" id="closeReason" hidden>Cada año se cae algún equipo. Si se libera una plaza, avisamos por orden de lista.</p>
      <p class="close-venue">📍 Polideportivo de Cabra del Santo Cristo (junto a la Plaza de los Nativos Ausentes)</p>
    </div>
    <div class="form-wrap reveal">
      <form class="form" id="inscribir-form" novalidate>
        <div class="field">
          <label for="team">Nombre del equipo</label>
          <input id="team" name="team" type="text" placeholder="Los Vasos Voladores" autocomplete="off" required />
        </div>
        <div class="row2">
          <div class="field">
            <label for="p1">Participante 1</label>
            <input id="p1" name="p1" type="text" placeholder="Nombre y apellido" autocomplete="off" required />
          </div>
          <div class="field">
            <label for="p2">Participante 2</label>
            <input id="p2" name="p2" type="text" placeholder="Nombre y apellido" autocomplete="off" required />
          </div>
        </div>
        <div class="field">
          <label for="tel">Teléfono de contacto</label>
          <input id="tel" name="tel" type="tel" inputmode="tel" placeholder="600 123 456" autocomplete="tel" required />
        </div>

        <!-- honeypot: fuera de pantalla y oculto a AT, no display:none -->
        <div class="hp" aria-hidden="true">
          <label for="web">No rellenar este campo</label>
          <input id="web" name="web" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button class="submit" type="submit">Reservar plaza →</button>
        <p class="fineprint">Inscripción: 10€ por equipo · Bizum o efectivo</p>
        <p class="form-msg" id="form-msg" role="alert" aria-live="assertive"></p>
      </form>

      <div class="form-success" id="form-success" role="status" aria-live="polite" hidden></div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('inscribir-form') as HTMLFormElement | null;
  const msg = document.getElementById('form-msg');
  const success = document.getElementById('form-success');
  const submitBtn = form?.querySelector<HTMLButtonElement>('.submit') ?? null;

  const eyebrow = document.getElementById('closeEyebrow');
  const title = document.getElementById('closeTitle');
  const copy = document.getElementById('closeCopy');
  const reason = document.getElementById('closeReason');

  const val = (id: string) =>
    (document.getElementById(id) as HTMLInputElement | null)?.value.trim() ?? '';

  // Texto del botón en reposo según el modo (inscripción / lista de espera).
  let idleLabel = 'Reservar plaza →';
  let sending = false;

  function showError(text: string) {
    if (msg) msg.textContent = text;
  }
  function clearError() {
    if (msg) msg.textContent = '';
  }
  function setSending(isSending: boolean) {
    sending = isSending;
    if (!submitBtn) return;
    submitBtn.disabled = isSending;
    submitBtn.textContent = isSending ? 'Enviando…' : idleLabel;
  }

  // Modo lista de espera: reacciona al estado real de stats (vía Hero).
  function applyMode(completo: boolean) {
    if (completo) {
      idleLabel = 'Únete a la lista de espera';
      if (eyebrow) eyebrow.textContent = 'Lista de espera';
      if (title) title.innerHTML = 'Lista de<br />espera';
      if (copy)
        copy.textContent =
          'Las 48 plazas están completas. Apúntate a la lista de espera y te guardamos el turno.';
      if (reason) reason.hidden = false;
    } else {
      idleLabel = 'Reservar plaza →';
      if (eyebrow) eyebrow.textContent = 'Inscripción abierta';
      if (title) title.innerHTML = 'Coge tu<br />plaza';
      if (copy)
        copy.textContent =
          'Solo 48 equipos. Cuando se llenan, se llenan. Rellena los datos y guardamos tu sitio.';
      if (reason) reason.hidden = true;
    }
    // no pises el "Enviando…" en curso
    if (submitBtn && !sending) submitBtn.textContent = idleLabel;
  }

  // Estado inicial (correcto al cargar) + en vivo por el mismo canal Realtime del contador.
  const cached = (window as unknown as { __stats?: { completo?: boolean } }).__stats;
  if (cached) applyMode(Boolean(cached.completo));
  document.addEventListener('stats:update', (event) => {
    const detail = (event as CustomEvent<{ completo?: boolean }>).detail;
    applyMode(Boolean(detail?.completo));
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearError();

    const payload = {
      nombre_equipo: val('team'),
      participante_1: val('p1'),
      participante_2: val('p2'),
      telefono: val('tel'),
      web: (document.getElementById('web') as HTMLInputElement | null)?.value ?? '',
    };

    // validación de cliente ligera (cortesía); la de verdad es la del servidor
    if (
      !payload.nombre_equipo ||
      !payload.participante_1 ||
      !payload.participante_2 ||
      !payload.telefono
    ) {
      showError('Rellena todos los campos, por favor.');
      return;
    }

    setSending(true);

    try {
      const res = await fetch('/api/inscribir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res
        .json()
        .catch(() => ({}) as { error?: string; estado?: string; posicion?: number | null });

      if (!res.ok) {
        showError(data.error || 'No se pudo enviar. Inténtalo de nuevo.');
        setSending(false);
        return;
      }

      // éxito: sustituye el formulario por el mensaje. El contador se actualiza solo (Realtime).
      if (form) form.hidden = true;
      if (success) {
        const checkIco =
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
        const clockIco =
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>';

        if (data.estado === 'espera') {
          const puesto =
            typeof data.posicion === 'number' ? ` (puesto nº ${data.posicion})` : '';
          success.innerHTML =
            `<span class="success-ico">${clockIco}</span><h3>Estás en la lista de espera</h3><p>Las 48 plazas están completas — os hemos apuntado en la lista de espera${puesto}. Si se libera una plaza, avisamos.</p>`;
        } else {
          success.innerHTML =
            `<span class="success-ico">${checkIco}</span><h3>¡Equipo inscrito!</h3><p>Nos pondremos en contacto para el pago: 10€ por equipo (Bizum o efectivo).</p>`;
        }
        success.hidden = false;
        success.setAttribute('tabindex', '-1');
        // transición sutil form→mensaje (se desactiva con reduced-motion vía CSS)
        requestAnimationFrame(() => success.classList.add('is-in'));
        success.focus();
      }
    } catch {
      showError('No se pudo conectar. Revisa tu conexión e inténtalo de nuevo.');
      setSending(false);
    }
  });
</script>

<style>
  .close {
    background: var(--cup);
    color: var(--cream);
    padding: 96px 0;
  }

  .close .eyebrow {
    color: var(--cream);
  }

  .close .eyebrow .dot {
    background: var(--cream);
  }

  .close h2 {
    font-family: var(--display);
    font-size: clamp(2.8rem, 8vw, 6rem);
    line-height: 0.9;
    text-transform: uppercase;
    margin: 16px 0 0;
  }

  .close p {
    max-width: 44ch;
    margin-top: 16px;
    font-size: 1.1rem;
    color: var(--cream);
  }

  .close-reason {
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.5;
    max-width: 46ch;
    margin-top: 12px;
    color: var(--cream);
    opacity: 0.9;
  }

  .close-venue {
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.5;
    max-width: 46ch;
    margin-top: 16px;
    color: var(--cream);
    opacity: 0.9;
  }

  .form {
    margin-top: 38px;
    max-width: 560px;
    display: grid;
    gap: 14px;
  }

  /* display:grid/flex ganan al [hidden] del navegador; forzamos ocultado real */
  .form[hidden],
  .form-success[hidden] {
    display: none;
  }

  .form .field {
    display: grid;
    gap: 6px;
  }

  .form label {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
  }

  .form input {
    font-family: var(--sans);
    font-size: 1rem;
    padding: 14px 16px;
    border-radius: 10px;
    border: 2px solid rgba(23, 14, 17, 0.35);
    background: rgba(255, 255, 255, 0.92);
    color: var(--night);
  }

  .form input::placeholder {
    color: rgba(23, 14, 17, 0.55);
  }

  .form input:focus {
    outline: none;
    border-color: var(--night);
    background: #fff;
  }

  .form .row2 {
    display: grid;
    gap: 14px;
  }

  @media (min-width: 560px) {
    .form .row2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form .submit {
    margin-top: 6px;
    background: var(--night);
    color: var(--cream);
    font-weight: 700;
    font-size: 1.05rem;
    padding: 16px;
    border-radius: 100px;
    border: none;
    cursor: pointer;
    font-family: var(--sans);
    transition: transform 0.15s ease;
  }

  .form .submit:hover {
    transform: translateY(-2px);
  }

  .fineprint {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--cream);
    margin-top: 16px;
  }

  /* honeypot: accesiblemente oculto pero presente en el DOM (no display:none) */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* mensaje de error inline: chip oscuro para legibilidad sobre el rojo */
  .form-msg {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--cream);
  }

  .form-msg:empty {
    display: none;
  }

  .form-msg:not(:empty) {
    background: rgba(23, 14, 17, 0.4);
    border: 1px solid rgba(23, 14, 17, 0.55);
    border-radius: 8px;
    padding: 10px 12px;
  }

  /* mensaje de confirmación que reemplaza al formulario: centrado y con presencia */
  .form-success {
    margin-top: 38px;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 40px 32px;
    border: 1px solid rgba(247, 239, 226, 0.35);
    border-radius: 20px;
    background: rgba(23, 14, 17, 0.22);
    /* transición sutil de entrada (desactivada en reduced-motion más abajo) */
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .form-success.is-in {
    opacity: 1;
    transform: none;
  }

  /* :global porque el contenido se inyecta por innerHTML (sin el atributo de scope de Astro) */
  .form-success :global(.success-ico) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: 18px;
    border-radius: 50%;
    color: var(--cream);
    border: 2px solid rgba(247, 239, 226, 0.5);
  }

  .form-success :global(.success-ico svg) {
    width: 28px;
    height: 28px;
  }

  .form-success :global(h3) {
    font-family: var(--display);
    text-transform: uppercase;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    line-height: 0.95;
    color: var(--cream);
  }

  .form-success :global(p) {
    margin-top: 12px;
    max-width: 40ch;
    font-size: 1.05rem;
    color: var(--cream);
  }

  .form-success:focus {
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .form-success {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
