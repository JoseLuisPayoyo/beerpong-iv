---
import { HORARIOS_NOCHE } from '../lib/horarios';

const horas = HORARIOS_NOCHE;
---

<section class="section noche">
  <div class="wrap">
    <div class="noche-flex">
      <div class="reveal">
        <span class="eyebrow"><span class="dot"></span>La noche</span>
        <p class="quote">Cuando cae el<br />último vaso,<br /><em>empieza la fiesta</em></p>
        <p class="noche-copy">
          Barra hasta el cierre y sesión de DJs hasta que el cuerpo aguante. El cartel se irá desvelando
          poco a poco.
        </p>
      </div>
      <div class="dj-card reveal">
        <svg width="0" height="0" style="position: absolute" aria-hidden="true">
          <symbol id="dj" viewBox="0 0 48 48">
            <g fill="currentColor">
              <path d="M6 47 C6 34 13 28 24 28 C35 28 42 34 42 47 Z"></path>
              <ellipse cx="24" cy="18" rx="11.5" ry="12"></ellipse>
              <rect x="7.5" y="16" width="6" height="13" rx="3"></rect>
              <rect x="34.5" y="16" width="6" height="13" rx="3"></rect>
            </g>
            <path
              d="M10 20 Q24 3 38 20"
              fill="none"
              stroke="currentColor"
              stroke-width="4"
              stroke-linecap="round"></path>
          </symbol>
        </svg>

        {
          horas.map((hora) => (
            <div class="dj-row">
              <span class="dj-id">
                <svg class="dj-ico" role="img" aria-label="DJ por confirmar">
                  <use href="#dj" />
                </svg>
                <span class="hidden-name">DJ por confirmar</span>
              </span>
              <span class="tag">{hora}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .noche {
    position: relative;
    overflow: hidden;
  }

  .noche::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse at 80% 20%, rgba(236, 58, 44, 0.18), transparent 55%),
      radial-gradient(ellipse at 10% 90%, rgba(255, 63, 139, 0.12), transparent 50%);
  }

  .noche .wrap {
    position: relative;
    z-index: 1;
  }

  .noche-flex {
    display: grid;
    gap: 30px;
    align-items: center;
  }

  @media (min-width: 820px) {
    .noche-flex {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .quote {
    font-family: var(--display);
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1;
    text-transform: uppercase;
    margin-top: 14px;
  }

  .quote em {
    color: var(--cup);
    font-style: normal;
  }

  .noche-copy {
    margin-top: 20px;
    color: var(--muted);
    max-width: 40ch;
  }

  .dj-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 26px;
  }

  .dj-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px dashed var(--line);
    font-family: var(--mono);
    font-size: 0.9rem;
  }

  .dj-row:last-child {
    border-bottom: none;
  }

  .dj-id {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .dj-ico {
    width: 44px;
    height: 44px;
    color: var(--cream);
    flex-shrink: 0;
  }

  .dj-row .hidden-name {
    letter-spacing: 0.05em;
  }

  .dj-row .tag {
    color: var(--muted);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
  }
</style>
