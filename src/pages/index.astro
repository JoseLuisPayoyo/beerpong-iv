---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import DiaNoche from '../components/DiaNoche.astro';
import Formato from '../components/Formato.astro';
import ProximamenteTorneo from '../components/ProximamenteTorneo.astro';
import Noche from '../components/Noche.astro';
import Ediciones from '../components/Ediciones.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Beerpong IV — 6 de agosto"
  description="El torneo de beer pong del pueblo. 48 equipos, una noche, un solo campeón. 6 de agosto en el polideportivo — inscripción abierta."
>
  <Nav />
  <main>
    <Hero />
    <DiaNoche />
    <Formato />
    <ProximamenteTorneo />
    <Noche />
    <Ediciones />
    <CtaFinal />
  </main>
  <Footer />
</Base>
