---
// Vista pública del torneo: página estática con una única isla React.
// No usa Base.astro a propósito: nada de GSAP ni estilos de la landing (se abre
// a las 2am con mala cobertura; bundle liviano). SÍ indexable (sin noindex).
import '@fontsource/anton';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/torneo.css';
import Analytics from '@vercel/analytics/astro';
import TorneoApp from '../components/torneo/TorneoApp';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta
      name="description"
      content="Sigue el Beerpong IV en directo: clasificación de grupos y cuadro de eliminatorias, actualizado al momento."
    />
    <meta name="theme-color" content="#170e11" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Beerpong IV · En directo</title>
  </head>
  <body>
    <TorneoApp client:only="react" />
    <Analytics />
  </body>
</html>
