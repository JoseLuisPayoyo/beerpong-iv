# Supabase — claves de CLIENTE (navegador). En Astro las vars públicas van con prefijo PUBLIC_.
# Copia este archivo a .env y rellena con los valores de tu proyecto Supabase.
PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXX"

# Supabase — clave de SERVIDOR (secret). SIN prefijo PUBLIC_ para que NUNCA llegue al navegador.
# Solo la usa el endpoint /api/inscribir. En producción, añádela también en Vercel.
SUPABASE_SECRET_KEY="sb_secret_XXXXXXXXXXXXXXXXXXXX"
